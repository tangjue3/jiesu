{
  "name": "jiesu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "面向 AI Coding 用户的可视化前端编辑器：直接改真实源码，改得确定、可预期、可撤销",
  "bin": {
    "jiesu": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/vite-plugin/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vitest run spikes/*/e2e.test.ts",
    "demo": "./scripts/demo.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.5",
    "@babel/types": "^7.26.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "magic-string": "^1.4.4",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.7",
    "vitest": "^3.0.5"
  }
}
