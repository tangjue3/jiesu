{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "spikes"],
  "exclude": [
    "node_modules",
    "dist",
    // 靶场与 demo 是被测对象，不是被测代码：它们故意包含非法/动态写法，不能纳入类型检查
    "spikes/**/fixtures",
    "spikes/**/demo"
  ]
}
